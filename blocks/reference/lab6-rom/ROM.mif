WIDTH=32;
DEPTH=32;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
    00 : 2001000C; -- addi $1, $0, 12   ($1 = 12)
    01 : 20020008; -- addi $2, $0, 8    ($2 = 8)
    02 : 20000000; -- addi $0, $0, 0    (NOP đệm nhóm addi -> chốt $2 = 8)
    03 : 00221820; -- add  $3, $1, $2   ($3 = 12 + 8 = 20)
    04 : 00000020; -- add  $0, $0, $0   (NOP đệm lệnh add -> chốt $3 = 20)
    05 : 0041202A; -- slt  $4, $2, $1   (8 < 12 -> Đúng -> $4 = 1)
    06 : 0000002A; -- slt  $0, $0, $0   (NOP đệm lệnh slt -> chốt $4 = 1)
    07 : AC430004; -- sw   $3, 4($2)    (Ghi $3 = 20 vào RAM[$2 + 4] = RAM[12])
    08 : 8C450004; -- lw   $5, 4($2)    (Đọc RAM[12] = 20 nạp vào $5)
    09 : 8C000000; -- lw   $0, 0($0)    (NOP đệm lệnh lw -> chốt $5 = 20)
    0A : 00A43020; -- add  $6, $5, $4   (Kiểm chứng: $5 + $4 = 20 + 1 = 21)
    [0B..1F] : 00000000;
END;